# ChessScope frontend configuration.
# Copy to `.env.local` and adjust if your backend is not on localhost:8000.
# Only variables prefixed with VITE_ are exposed to the browser bundle.

# Base URL of the ChessScope backend HTTP API.
VITE_API_BASE_URL=http://localhost:8000

# Base URL for the analysis progress WebSocket.
# Optional: if omitted, it is derived from VITE_API_BASE_URL
# (http -> ws, https -> wss).
VITE_WS_BASE_URL=ws://localhost:8000

# Copy this file to backend/.env and adjust as needed.

DATABASE_URL=postgresql+psycopg://chessscope:chessscope@localhost:5432/chessscope
REDIS_URL=redis://localhost:6379/0

STOCKFISH_PATH=/opt/homebrew/bin/stockfish
STOCKFISH_DEPTH=18
# Search threads per Stockfish process (default 1 wastes most of the machine).
# Keep below the core count so the rest of the stack still gets CPU.
STOCKFISH_THREADS=3
# Transposition table size in MB (Stockfish's own default is a tiny 16).
STOCKFISH_HASH_MB=512

# Parallel analysis pool: one job runs ANALYSIS_POOL_SIZE Stockfish processes
# at once, each with ANALYSIS_POOL_THREADS_PER_ENGINE search threads
# (4 x 2 = 8 threads on a 10-core machine, leaving room for a bot move).
ANALYSIS_POOL_SIZE=4
ANALYSIS_POOL_THREADS_PER_ENGINE=2

CORS_ORIGINS=http://localhost:5173

LICHESS_API_BASE=https://lichess.org
